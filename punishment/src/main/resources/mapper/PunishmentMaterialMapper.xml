<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.intelligent.trial.punishment.mapper.PunishmentMaterialMapper">

    <resultMap id="BaseResultMap" type="com.intelligent.trial.punishment.entity.PunishmentMaterial">
        <id column="id" property="id"/>
        <result column="execution_id" property="executionId"/>
        <result column="material_type" property="materialType"/>
        <result column="file_path" property="filePath"/>
        <result column="upload_time" property="uploadTime"/>
        <result column="uploader_id" property="uploaderId"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <!-- 按执行ID查询材料列表 -->
    <select id="selectByExecutionId" resultMap="BaseResultMap">
        SELECT * FROM punishment_material
        WHERE execution_id = #{executionId}
        ORDER BY upload_time DESC
    </select>

</mapper>
