<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.intelligent.trial.promotion.mapper.CasePromotionMapper">

    <resultMap id="BaseResultMap" type="com.intelligent.trial.promotion.entity.CasePromotion">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="case_id" property="caseId" jdbcType="VARCHAR"/>
        <result column="template_id" property="templateId" jdbcType="BIGINT"/>
        <result column="content" property="content" jdbcType="LONGVARCHAR"/>
        <result column="status" property="status" jdbcType="TINYINT"/>
        <result column="user_id" property="userId" jdbcType="BIGINT"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="update_time" property="updateTime" jdbcType="TIMESTAMP"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, case_id, template_id, content, status, user_id, create_time, update_time
    </sql>

    <!-- 根据案件ID查询 -->
    <select id="selectByCaseId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM case_promotion
        WHERE case_id = #{caseId}
        ORDER BY create_time DESC
        LIMIT 1
    </select>

    <!-- 根据状态查询列表 -->
    <select id="selectByStatus" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM case_promotion
        WHERE status = #{status}
        ORDER BY create_time DESC
    </select>

</mapper>
