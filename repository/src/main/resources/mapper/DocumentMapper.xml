<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.intelligent.trial.repository.mapper.DocumentMapper">

    <!-- 通用结果映射 -->
    <resultMap id="BaseResultMap" type="com.intelligent.trial.repository.entity.Document">
        <id column="id" property="id"/>
        <result column="repo_type" property="repoType"/>
        <result column="directory_id" property="directoryId"/>
        <result column="title" property="title"/>
        <result column="doc_no" property="docNo"/>
        <result column="publish_unit" property="publishUnit"/>
        <result column="publish_date" property="publishDate"/>
        <result column="effective_date" property="effectiveDate"/>
        <result column="revision_date" property="revisionDate"/>
        <result column="validity_status" property="validityStatus"/>
        <result column="classification_level_id" property="classificationLevelId"/>
        <result column="file_path" property="filePath"/>
        <result column="file_size" property="fileSize"/>
        <result column="file_type" property="fileType"/>
        <result column="summary" property="summary"/>
        <result column="vector_id" property="vectorId"/>
        <result column="status" property="status"/>
        <result column="case_id" property="caseId"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="create_by" property="createBy"/>
        <result column="update_by" property="updateBy"/>
    </resultMap>

    <!-- 多条件搜索文档（分页） -->
    <select id="searchDocuments" resultMap="BaseResultMap">
        SELECT * FROM repo_document
        <where>
            <if test="repoType != null">
                AND repo_type = #{repoType}
            </if>
            <if test="keyword != null and keyword != ''">
                AND (
                    title LIKE CONCAT('%', #{keyword}, '%')
                    OR doc_no LIKE CONCAT('%', #{keyword}, '%')
                    OR publish_unit LIKE CONCAT('%', #{keyword}, '%')
                )
            </if>
            <if test="directoryId != null">
                AND directory_id = #{directoryId}
            </if>
            <if test="validityStatus != null and validityStatus != ''">
                AND validity_status = #{validityStatus}
            </if>
            <if test="publishDateStart != null">
                AND publish_date &gt;= #{publishDateStart}
            </if>
            <if test="publishDateEnd != null">
                AND publish_date &lt;= #{publishDateEnd}
            </if>
            <if test="classificationLevelId != null">
                AND classification_level_id = #{classificationLevelId}
            </if>
            <if test="publishUnit != null and publishUnit != ''">
                AND publish_unit LIKE CONCAT('%', #{publishUnit}, '%')
            </if>
            <if test="caseId != null">
                AND case_id = #{caseId}
            </if>
        </where>
        ORDER BY publish_date DESC, create_time DESC
    </select>

    <!-- 根据案件ID查询关联文档 -->
    <select id="selectByCaseId" resultMap="BaseResultMap">
        SELECT * FROM repo_document
        WHERE case_id = #{caseId}
        ORDER BY create_time DESC
    </select>

</mapper>
