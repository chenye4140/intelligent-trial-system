<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="http://www.intelligent-trial.com/case-review"
             typeLanguage="http://www.w3.org/2001/XMLSchema"
             expressionLanguage="http://www.w3.org/1999/XPath">

    <process id="case-review-approval" name="案件审理审批流程" isExecutable="true">

        <documentation>案件审理审批流程：提交申请 → 部门审核 → 纪检审核 → 领导审批 → 结束</documentation>

        <!-- 开始事件 -->
        <startEvent id="startEvent" name="提交申请" flowable:initiator="initiator"/>

        <!-- 部门审核 -->
        <userTask id="departmentReview" name="部门审核"
                  flowable:candidateGroups="department"
                  flowable:assignee="${departmentAssignee}">
            <documentation>部门审核环节，由部门负责人审核案件材料</documentation>
        </userTask>

        <!-- 纪检审核 -->
        <userTask id="disciplineReview" name="纪检审核"
                  flowable:candidateGroups="discipline"
                  flowable:assignee="${disciplineAssignee}">
            <documentation>纪检审核环节，由纪检部门审核案件合规性</documentation>
        </userTask>

        <!-- 领导审批 -->
        <userTask id="leaderApproval" name="领导审批"
                  flowable:candidateGroups="leader"
                  flowable:assignee="${leaderAssignee}">
            <documentation>领导审批环节，由分管领导最终审批</documentation>
        </userTask>

        <!-- 结束事件 -->
        <endEvent id="endEvent" name="结束"/>

        <!-- 流程连线 -->
        <sequenceFlow id="flow1" sourceRef="startEvent" targetRef="departmentReview" name="提交"/>
        <sequenceFlow id="flow2" sourceRef="departmentReview" targetRef="disciplineReview" name="部门审核通过"/>
        <sequenceFlow id="flow3" sourceRef="disciplineReview" targetRef="leaderApproval" name="纪检审核通过"/>
        <sequenceFlow id="flow4" sourceRef="leaderApproval" targetRef="endEvent" name="领导审批通过"/>

    </process>

</definitions>
