# ============================================
# AI 纪检监察智能审理一体化平台
# 环境变量配置模板
# 使用: cp .env.example .env && 编辑 .env
# ============================================

# ── MySQL ──
MYSQL_PASSWORD=TrialPass@2026!

# ── Redis ──
REDIS_PASSWORD=Redis@Trial2026!

# ── MinIO ──
MINIO_SECRET_KEY=MinioAdmin@2026!

# ── JWT ──
JWT_SECRET=your-super-secret-jwt-key-change-in-production-2026
JWT_EXPIRATION=86400000

# ── AI (DeepSeek / DashScope) ──
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DASHSCOPE_API_KEY=sk-your-dashscope-api-key

# ── CORS ──
CORS_ALLOWED_ORIGINS=http://localhost:80,http://localhost:5173
