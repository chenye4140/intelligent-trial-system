<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.intelligent.trial.document.mapper.DocParseTaskMapper">

    <!-- 通用结果映射 -->
    <resultMap id="BaseResultMap" type="com.intelligent.trial.document.entity.DocParseTask">
        <id column="id" property="id"/>
        <result column="file_name" property="fileName"/>
        <result column="file_path" property="filePath"/>
        <result column="file_type" property="fileType"/>
        <result column="status" property="status"/>
        <result column="progress" property="progress"/>
        <result column="result_json" property="resultJson"/>
        <result column="error_msg" property="errorMsg"/>
        <result column="parse_time" property="parseTime"/>
        <result column="vector_count" property="vectorCount"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <!-- 通用列 -->
    <sql id="Base_Column_List">
        id, file_name, file_path, file_type, status, progress,
        result_json, error_msg, parse_time, vector_count,
        create_time, update_time
    </sql>

</mapper>
